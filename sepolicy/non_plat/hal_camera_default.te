# this needs access to vndbinder
vndbinder_use(hal_camera_default)

# our camera hal uses the gpu
allow hal_camera_default gpu_device:chr_file rw_file_perms;

# allow camera hal to access dir from storage
allow hal_camera_default storage_file:dir rw_dir_perms;
allow hal_camera_default storage_file:lnk_file rw_file_perms;

# allow camera hal to access IMapper service
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
